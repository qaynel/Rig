# Secrets, never commit API keys
.env
.env.*
!.env.example

# Local credential/env files (signing keys, tokens); only *.example is tracked
.credentials/*
!.credentials/*.example

# Dependencies
node_modules/
.DS_Store

# promptfoo eval artifacts
.promptfoo/
benchmarks/output*
benchmarks/benchmark-local-results.json

# Python
__pycache__/
.venv/

# one-off social/announcement art, not repo content
announce-*.png
changelog-*.png
rig-*.gif

# Claude Code local settings (machine-specific permission grants)
.claude/settings.local.json

# The project wiki lives locally for agents and on the GitHub Wiki tab for the
# community. It is not tracked here, except the Gate 1 oracle. prod's gate1-pin
# job reads those files from the candidate commit: pull_request_target runs the
# workflow from the base branch, so a restore step added only on this branch
# never runs.
wiki/*
!wiki/gate1/
wiki/gate1/*
!wiki/gate1/acceptance.md
!wiki/gate1/business-spec.md
!wiki/gate1/gate1.allowed-signers
!wiki/gate1/gate1.sig
!wiki/gate1/package-scripts.json
!wiki/gate1/testing-infrastructure.manifest

# agentic benchmark workspaces (agent output, kept locally for inspection)
benchmarks/agentic/runs/

# PR/branch review harness scratch dir (worktree, diff, meta) — net-zero by design
.pr-review/

# superpowers agent scratch (per-task SDD reports, run state) — authoring-time only
.superpowers/

# agent workspace scratch (signing inputs, context notes) — machine-local only
# approve-gate1.js writes rig-oracle-freeze-v2.txt here before signing; it is
# a convenience echo, not a trust input (check-advanced-spec.js recomputes it).
.context/
