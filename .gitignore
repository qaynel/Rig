# Secrets, never commit API keys
.env
.env.*
!.env.example

# Local credential/env files (signing keys, tokens); only *.example is tracked
.credentials/*
!.credentials/*.example

# Dependencies
node_modules/
.DS_Store

# promptfoo eval artifacts
.promptfoo/
benchmarks/output*
benchmarks/benchmark-local-results.json

# Python
__pycache__/
.venv/

# one-off social/announcement art, not repo content
announce-*.png
changelog-*.png
rig-*.gif

# Claude Code local settings (machine-specific permission grants)
.claude/settings.local.json

# Obsidian local app/plugin state for the wiki (editor cache + vendored plugin
# binaries); the board markdown is tracked, this machine-specific state is not.
wiki/.obsidian/

# agentic benchmark workspaces (agent output, kept locally for inspection)
benchmarks/agentic/runs/

# PR/branch review harness scratch dir (worktree, diff, meta) — net-zero by design
.pr-review/
