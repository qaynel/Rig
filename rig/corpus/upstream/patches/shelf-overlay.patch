+# to distinguish a complete current install from an interrupted regeneration.
+install_file "$VERSION_FILE" "$GENERATED_DIR/.rig-version"
+
+echo "rig-ios-qa-regen: bridge package ready at $BRIDGE_DIR"
+echo "rig-ios-qa-regen: accessors ready at $GENERATED_DIR/StateAccessor.swift"
