+      name: "code",
+      ran: true,
+      ok: false,
+      duration_ms: Date.now() - t0,
+      summary: `${baseSummary}; attach FAILED (${reason}) — code-def queries from this worktree will hit the default source until /sync-brain succeeds`,
+      detail: {
+        source_id: sourceId,
+        source_path: root,
+        page_count: pageCount,
+        last_imported: new Date().toISOString(),
+        status: "failed",
+      },
+    };
