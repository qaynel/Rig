+      name: "code",
+      ran: true,
+      ok: false,
+      duration_ms: Date.now() - t0,
+      summary: `brain sync --strategy code --source ${sourceId} exited ${walkResult.status}`,
+      detail: { source_id: sourceId, source_path: root, status: "failed" },
+    };
+  }
+
+  if (args.mode === "full") {
+    const reindexResult = spawnbrain(["reindex-code", "--source", sourceId, "--yes"], {
