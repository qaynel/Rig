+    name: "code",
+    ran: true,
+    ok: true,
+    duration_ms: Date.now() - t0,
+    summary: baseSummary,
+    detail: {
+      source_id: sourceId,
+      source_path: root,
+      page_count: pageCount,
+      last_imported: new Date().toISOString(),
+      status: "ok",
+    },
+  };
+}
