+private indirect enum JSONSnapshotType {
+    case scalar
+    case optional(JSONSnapshotType)
+    case array(JSONSnapshotType)
+    case dictionary(JSONSnapshotType)
+
+    var isOptional: Bool {
+        if case .optional = self { return true }
+        return false
