#!/usr/bin/env bash
# rig-review-read — read review log and config for dashboard
# Usage: rig-review-read
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
eval "$("$SCRIPT_DIR/rig-slug" 2>/dev/null)"
RIG_HOME="${RIG_HOME:-$HOME/.rig}"
cat "$RIG_HOME/projects/$SLUG/$BRANCH-reviews.jsonl" 2>/dev/null || echo "NO_REVIEWS"
echo "---CONFIG---"
"$SCRIPT_DIR/rig-config" get skip_eng_review 2>/dev/null || echo "false"
echo "---HEAD---"
git rev-parse --short HEAD 2>/dev/null || echo "unknown"
