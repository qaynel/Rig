#!/usr/bin/env bash
# rig-paths — output portable state-root paths for skill bash blocks
# Usage: eval "$(rig-paths)"  → sets RIG_STATE_ROOT, PLAN_ROOT, TMP_ROOT
# Or:    rig-paths            → prints RIG_STATE_ROOT=... etc.
#
# Resolves three roots with explicit fallback chains so skills work the same
# whether installed as a Claude Code plugin (CLAUDE_PLUGIN_DATA / CLAUDE_PLANS_DIR
# set), a global ~/.claude/skills/rig/ install, or a local checkout under
# CI / container env where HOME may be unset.
#
# Chains:
#   RIG_STATE_ROOT: RIG_HOME -> CLAUDE_PLUGIN_DATA (only when CLAUDE_PLUGIN_ROOT=*rig*) -> $HOME/.rig -> .rig
#   PLAN_ROOT:         RIG_PLAN_DIR -> CLAUDE_PLANS_DIR -> $HOME/.claude/plans -> .claude/plans
#   TMP_ROOT:          TMPDIR -> TMP -> .rig/tmp (and mkdir -p, best-effort)
#
# Security: output values are not sanitized — callers may receive paths with
# shell-special characters if env vars contain them. Skills should always quote
# expansions ("$RIG_STATE_ROOT", not $RIG_STATE_ROOT).
set -u

# State root: where rig writes projects/, sessions/, analytics/.
if [ -n "${RIG_HOME:-}" ]; then
  _state_root="$RIG_HOME"
elif [ -n "${CLAUDE_PLUGIN_DATA:-}" ] && echo "${CLAUDE_PLUGIN_ROOT:-}" | grep -qi "rig"; then
  # Guard: only trust CLAUDE_PLUGIN_DATA when CLAUDE_PLUGIN_ROOT confirms we are
  # running as the rig plugin. Without this, a CLAUDE_PLUGIN_DATA from another
  # plugin (e.g. codex) that leaked into the session env via CLAUDE_ENV_FILE would
  # be picked up, writing all rig state into the wrong directory.
  _state_root="$CLAUDE_PLUGIN_DATA"
elif [ -n "${HOME:-}" ]; then
  _state_root="$HOME/.rig"
else
  _state_root=".rig"
fi

# Plan root: where /context-save and /codex consult write plan files.
if [ -n "${RIG_PLAN_DIR:-}" ]; then
  _plan_root="$RIG_PLAN_DIR"
elif [ -n "${CLAUDE_PLANS_DIR:-}" ]; then
  _plan_root="$CLAUDE_PLANS_DIR"
elif [ -n "${HOME:-}" ]; then
  _plan_root="$HOME/.claude/plans"
else
  _plan_root=".claude/plans"
fi

# Tmp root: where ephemeral files (codex stderr captures, etc.) live.
# Honor TMPDIR / TMP for Windows + container compat; fall back to a
# project-local .rig/tmp so we never write to a system /tmp that may
# be read-only or shared.
if [ -n "${TMPDIR:-}" ]; then
  _tmp_root="$TMPDIR"
elif [ -n "${TMP:-}" ]; then
  _tmp_root="$TMP"
else
  _tmp_root=".rig/tmp"
fi

# Best-effort mkdir; if it fails (read-only fs, permission denied), the caller
# will discover that on their own write attempt. Don't fail the eval here.
mkdir -p "$_tmp_root" 2>/dev/null || true

echo "RIG_STATE_ROOT=$_state_root"
echo "PLAN_ROOT=$_plan_root"
echo "TMP_ROOT=$_tmp_root"
