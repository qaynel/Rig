#!/usr/bin/env bash
# rig-builder-profile — LEGACY SHIM.
#
# Superseded by bin/rig-developer-profile. This binary now delegates to
# `rig-developer-profile --read` to keep /office-hours working during the
# transition. When all call sites have been updated, this file can be removed.
#
# The migration from ~/.rig/builder-profile.jsonl to the unified
# ~/.rig/developer-profile.json happens automatically on first read —
# see bin/rig-developer-profile --migrate for details.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$SCRIPT_DIR/rig-developer-profile" --read "$@"
